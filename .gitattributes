# Normalize line endings — checked into repo as LF, checked out per OS.
* text=auto eol=lf

# Always LF for files Vercel (Linux) serves verbatim
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
